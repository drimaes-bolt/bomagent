# Claude Code 로컬 설정 (개인 설정, 공유하지 않는다)
.claude/settings.local.json

# 엑셀 잠금·임시 파일
~$*
*.tmp

# OS가 만드는 파일
Thumbs.db
Desktop.ini
.DS_Store

# 제조사 카탈로그·셀렉션 가이드 PDF(R13): 제조사 저작물이라 공개 저장소에 올리지 않는다. 수집 목록(manifest)만 추적한다
references/R13_Vendor_Guides/**/*.pdf

# 파이썬 캐시
__pycache__/
*.pyc

# AVL DB 작업 중 생기는 캐시
AVL_DB/_source/txt_cache/
AVL_DB/_source/rows_checked.json

# AVL 백데이터(비공개): 공식 내보내기·오픈 데이터·사이트 표에서 모은 원천 데이터. 데모에 넣는 부분만 index.html로 공개한다(2026-11-27 사용자 결정)
AVL_DB/_private/
